# Copy to deploy/vps/.env on the VPS (ignored by Git) and fill in.
SENTINEL_ADMIN_USERNAME=admin
# python -m backend.admin_auth  -> paste the scrypt$... value
SENTINEL_ADMIN_PASSWORD_HASH=
# Same value as /etc/sentinel-bridge.env
SENTINEL_ADMIN_KEY=
# Never propose blocks for the VPS itself or the internal Docker addresses
SENTINEL_PROTECTED_IPS=<vps-public-ipv4>,<vps-public-ipv6>,<caddy-network-gateway>,<caddy-container-ip>
SENTINEL_MODEL=sentinel-qwen3.5-4b-r2:latest
OLLAMA_URL=http://127.0.0.1:11434
# Access: SSH tunnel only (default) or a public HTTPS name through the shared Caddy.
# Tunnel only: keep UVICORN_HOST=127.0.0.1 and SENTINEL_COOKIE_SECURE=0.
# Public name: bind the gateway IP of Caddy's Docker network, trust Caddy's forwarded
# client IP, allow the hostname and use secure cookies.
UVICORN_HOST=127.0.0.1
#UVICORN_HOST=<caddy-network-gateway>
#UVICORN_PROXY_HEADERS=true
#FORWARDED_ALLOW_IPS=<caddy-container-ip>
#SENTINEL_ALLOWED_HOSTS=<dashboard-hostname>
SENTINEL_COOKIE_SECURE=0
SENTINEL_ENABLE_DEMO=0
# 1 = approved blocks stay until an admin unblocks them on the dashboard
SENTINEL_MANUAL_UNBLOCK=1
# 1 = honeypot, scanner paths and CRITICAL floods are blocked for 600 s without a human (max 10 IP/hour)
SENTINEL_AUTO_APPROVE=0
# 1 = 'Ask me' on the mascot explains an incident from backend/kb (read-only, never blocks or unblocks)
SENTINEL_RAG=0
# Model for Ask me; empty = SENTINEL_MODEL (no model swap on the GPU)
SENTINEL_RAG_MODEL=
# 0 = answer with the KB note itself (no model call, exam default). 1 = the model may rephrase it (number checks, 409 while an incident is analysed)
SENTINEL_RAG_GENERATE=0
# Shown on the dashboard; build-time only
VITE_PROTECTED_SITE_HOST=
VITE_PROTECTED_SITE_IP=
