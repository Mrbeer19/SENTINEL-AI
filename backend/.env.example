SENTINEL_MODEL=qwen3.5:4b
OLLAMA_URL=http://127.0.0.1:11434
# Only needed if a remote operator must use the SOC API (reads and writes).
SENTINEL_ADMIN_KEY=
# Never-blockable IPs besides loopback, comma separated. Demo day: hotspot gateway + M5 LAN IP.
SENTINEL_PROTECTED_IPS=
# Extra Host/Origin names besides localhost and 127.0.0.1 (DNS rebinding / CSRF guard). make run-lan adds HOST itself.
SENTINEL_ALLOWED_HOSTS=
# 1 = send Ollama `format` JSON schema (returned HTTP 501 on the MLX runner; leave off until verified).
SENTINEL_OLLAMA_FORMAT=0
SENTINEL_OLLAMA_TIMEOUT=90
# Keep off for live rod-mai-rod monitoring. Enable only with a separate lab database.
SENTINEL_ENABLE_DEMO=0
# Remote peers: max demo requests per window (seconds).
SENTINEL_DEMO_RATE_LIMIT=30
SENTINEL_DEMO_RATE_WINDOW=10
# Optional overrides
# SENTINEL_PROMPT_PATH=model/prompts/analyst_system_v1.md
# SENTINEL_RULES_DIR=backend/rules
