[Unit]
Description=Sentinel SSH and TCP metadata sensor
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/rod-mai-rod/sentinel/vps_sensor.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
